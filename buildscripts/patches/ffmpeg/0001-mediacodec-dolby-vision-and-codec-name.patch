+++ b/libavcodec/mediacodec_wrapper.c
@@ -1435,6 +1435,39 @@ FFAMediaCodec* ff_AMediaCodec_createDecoderByType(const char *mime)
     return ff_AMediaCodec_createDecoderByType_jni(mime);
 }
 
+FFAMediaCodec* ff_AMediaCodec_createCodecByName(const char *name)
+{
+    FFAMediaCodec *codec = NULL;
+    JNIEnv *env = NULL;
+    jstring name_jstr = NULL;
+    jobject media_codec = NULL;
+
+    if (!name) return NULL;
+
+    env = ff_jni_get_env(NULL);
+    if (!env) return NULL;
+
+    name_jstr = ff_jni_utf_chars_to_jstring(env, name, NULL);
+    if (!name_jstr) return NULL;
+
+    media_codec = (*env)->CallStaticObjectMethod(env,
+                                                 j_mediacodec_class.mediacodec_class,
+                                                 j_mediacodec_class.create_by_codec_name_id,
+                                                 name_jstr);
+    if (ff_jni_exception_check(env, 1, NULL) < 0 || !media_codec) {
+        (*env)->DeleteLocalRef(env, name_jstr);
+        return NULL;
+    }
+    (*env)->DeleteLocalRef(env, name_jstr);
+
+    codec = av_mallocz(sizeof(FFAMediaCodec));
+    if (!codec) return NULL;
+    codec->object = (*env)->NewGlobalRef(env, media_codec);
+    (*env)->DeleteLocalRef(env, media_codec);
+    codec->jfields = &j_mediacodec_class;
+    return codec;
+}
+
 int ff_AMediaCodec_delete(FFAMediaCodec* codec)
 {
     int ret = 0;
