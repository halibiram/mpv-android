+        if (!is_dovi && av_packet_side_data_get(avctx->coded_side_data, avctx->nb_coded_side_data, AV_PKT_DATA_DOVI_CONF)) {
+            is_dovi = 1;
+        }
+        if (is_dovi) {
+            av_log(avctx, AV_LOG_INFO, "Dolby Vision stream detected, trying video/dolby-vision decoder\n");
+            target_mime = "video/dolby-vision";
+        }
+    }
 
